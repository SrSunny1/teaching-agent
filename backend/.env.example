# 复制为 .env 并填入真实值。.env 已在 .gitignore 里，不会进版本库。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 走 OpenAI 兼容接口，换供应商只改这三行
BASE_URL=https://api.deepseek.com/v1
# DeepSeek 当前可用的模型：deepseek-flash（支持图片）、deepseek-v4-pro（纯文本）。
# ★ deepseek-chat 已不在模型列表里了，别再写回来。
MODEL=deepseek-flash
# B2 金相图像诊断需要多模态模型 —— deepseek-flash 能读图；v4-pro 会返回 [Unsupported Image]
VISION_MODEL=deepseek-flash

# RAG 召回条数
RAG_TOP_K=4
# Agent 单轮最多几次工具调用，防止打转
MAX_TURNS=6
