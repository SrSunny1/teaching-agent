# ---------------------------------------------------------------------------
# 材料科学 RAG 知识库 · 配置模板
# 用法：复制为 .env（同目录），按需修改后重启即可。
# 说明：所有变量都是可选的，不填也能跑（会降级为零依赖模式）。
# ---------------------------------------------------------------------------

# ---------------- 服务 ----------------
MSRAG_HOST=127.0.0.1
MSRAG_PORT=8765
# 跨域白名单。留空 = 只允许同源，这样可以防止用户浏览器里的任意网页
# 静默读取本机知识库。插件的正常接入方式是 SDK / 命令行（服务端调用，
# 不受 CORS 限制），只有当你在浏览器里做跨域前端时才需要填写，例如：
#   MSRAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
# 万不得已才用 *（等于对任何网页开放）。
MSRAG_CORS_ORIGINS=
MSRAG_DEBUG=true

# 启动行为
MSRAG_AUTO_SEED=true        # 首次启动自动灌入内置示例语料
MSRAG_OPEN_BROWSER=true     # 启动后自动打开浏览器
MSRAG_SMOKE_TEST=true       # 启动后自动跑一遍自检

# ---------------- 大模型（生成）----------------
# 留空则使用「抽取式作答」（直接摘录证据原文，不需要任何外部服务）。
# 填入 Key 后自动升级为生成式回答。
MSRAG_LLM_API_KEY=
MSRAG_LLM_BASE_URL=https://api.deepseek.com
MSRAG_LLM_ENDPOINT=/chat/completions
MSRAG_LLM_MODEL=deepseek-chat
MSRAG_LLM_TEMPERATURE=0.2
MSRAG_LLM_MAX_TOKENS=2048
MSRAG_LLM_TIMEOUT=120

# 也兼容这些常见写法（优先级低于 MSRAG_*）：
# DEEPSEEK_API_KEY / LLM_API_KEY / OPENAI_API_KEY / LLM_BASE_URL / LLM_MODEL

# ---------------- 嵌入（检索）----------------
# auto  : 依次尝试 远端 API -> 本地模型 -> 零依赖哈希向量
# api   : 只用远端（OpenAI 兼容 /embeddings）
# local : 只用本地 sentence-transformers / FlagEmbedding
# hash  : 强制零依赖哈希向量（离线可用，词法级检索）
MSRAG_EMBEDDING_PROVIDER=auto
MSRAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
MSRAG_EMBEDDING_ENDPOINT=/embeddings
MSRAG_EMBEDDING_MODEL=BAAI/bge-m3
# 不配置时会自动复用上面的 LLM Key（多数 OpenAI 兼容厂商一个 Key 通吃）
MSRAG_EMBEDDING_API_KEY=
MSRAG_EMBEDDING_TIMEOUT=30
# 仅在 hash 模式下生效的向量维度
MSRAG_EMBEDDING_DIM=512

# ---------------- 检索 ----------------
MSRAG_TOP_K=6                 # 默认返回的证据条数（1~50）
MSRAG_MAX_TOP_K=50
MSRAG_ENABLE_BM25=true        # 关键词通道，与语义向量混合
MSRAG_BM25_WEIGHT=0.35        # BM25 在融合分中的占比
MSRAG_MIN_RELEVANCE=0.0       # 低于该分数的证据丢弃

# ---------------- 分块 ----------------
MSRAG_CHUNK_SIZE=700          # 每个检索子块的 token 预算
MSRAG_CHUNK_OVERLAP=120       # 相邻子块的重叠 token
MSRAG_MIN_CHUNK_TOKENS=30     # 过短的尾块并入上一块

# ---------------- 解析 / 上传 ----------------
# auto   : 有 PaddleOCR 就用，否则走文本层提取
# paddle : 强制 OCR（适合扫描件）
# text   : 强制文本层提取（最快）
MSRAG_PARSER_MODE=auto
MSRAG_MAX_UPLOAD_MB=50

# ---------------- ppsV3 版面解析（可选，较慢）----------------
# 用 PP-StructureV3 做版面级解析：能识别表格/公式/图题并保留版式结构，
# 质量最好但单篇 PDF 常需数十秒到几分钟，所以默认关闭。
# 依赖 Python 3.9~3.11 + paddleocr；插件通过子进程调用（跨解释器隔离），
# 环境不可用时自动降级到内置解析器，不影响入库。
# 也可以在插件的「设置」页面里直接开启并一键检测环境。
MSRAG_PPSV3_ENABLED=false
# 留空 = 自动探测（依次尝试 本项 -> 项目内 .venv -> 系统 python3.11/3.10/3.9）
MSRAG_PPSV3_PYTHON=
# 留空 = 使用插件内置的 ppsv3/rag.py
MSRAG_PPSV3_SCRIPT=
MSRAG_PPSV3_DEVICE=cpu          # cpu 或 gpu:0
MSRAG_PPSV3_ACCURATE=false      # true = 开启表格/公式/图表识别（更慢、更吃显存）
MSRAG_PPSV3_TIMEOUT=900         # 单篇解析超时（秒）
