# Windows 批处理必须是 CRLF 换行，否则双击会报「不是内部或外部命令」。
# 强制这几类文件用 CRLF，其余文件的换行交给各平台默认。
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件不许 git 动换行
*.doc  binary
*.docx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.ttf  binary

# 其余源码统一 LF，避免四个人各自换行导致整文件冲突
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
